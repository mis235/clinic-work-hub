# --- Server ---
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

# --- Admin login (prototype: single admin account) ---
ADMIN_EMAIL=admin@drnishitaranka.com
ADMIN_PASSWORD=change-this-password

# --- WhatsApp Cloud API (from Meta for Developers > WhatsApp > API Setup) ---
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_API_VERSION=v20.0

# --- Webhook verification (you choose this string, then enter the same one in Meta's webhook config) ---
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token

# --- Name of the pre-approved WhatsApp message template used to send tasks ---
WHATSAPP_TASK_TEMPLATE_NAME=task_assignment
WHATSAPP_TASK_TEMPLATE_LANG=en

# --- Biometric attendance (WebAuthn - uses each phone's own biometric sensor) ---
# RP_ID must be the bare domain (no https://, no port) that the app is served from.
# For local development this is "localhost". In production it must exactly match
# the domain in the browser's address bar, e.g. "workhub.drnishitaranka.com".
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Dr. Nishita's Clinic Work Hub"
# Full origin including scheme, matching where the frontend is actually served.
WEBAUTHN_ORIGIN=http://localhost:5173

# --- AI Advisors (specialist agents for workforce/staffing questions) ---
# Get a key from console.anthropic.com. Without this, the AI Advisors feature
# is disabled but the rest of the app works normally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email (Gmail SMTP via App Password) ---
# Used for automatic payslip delivery and the daily checklist digest.
# Setup: Google Account > Security > 2-Step Verification (must be ON) >
# App Passwords > create one for "Mail". Use that 16-character password below,
# NOT your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Scheduled jobs (cron syntax: minute hour day month weekday) ---
# Default: payroll runs 9am on the 1st of each month; checklist digest runs 8am daily.
PAYROLL_CRON="0 9 1 * *"
CHECKLIST_DIGEST_CRON="0 8 * * *"
# Set to "true" to disable both schedules entirely (used automatically by test-e2e.sh).
DISABLE_CRON=false
